# Copy this file to `.env` before the first run:  cp .env.example .env
#
# `.env` is git-ignored but IS declared as a Flutter asset in pubspec.yaml, so
# the file must exist or `flutter build` fails with "unable to find asset".
#
# Resolution priority (highest wins):
#   1. --dart-define flags   ← release builds are driven by these
#   2. this .env file        ← local development convenience
#   3. lib/core/constants/api_constants.dart

# ── Backend URLs ──────────────────────────────────────────────────────────────
# Leave commented to fall back to ApiConstants. Uncomment to override locally.
# iOS note: App Transport Security blocks cleartext http:// and raw-IP hosts,
# so an iOS run/build needs an https:// URL here (or via --dart-define).
# API_BASE_URL=https://staging-api.zygonich.com
# SOCKET_BASE_URL=https://staging-api.zygonich.com

# ── Agora (video/audio calls) ─────────────────────────────────────────────────
# Leave blank to use the App ID compiled into ApiConstants.
AGORA_APP_ID=

# ── Cashfree Payment Gateway ──────────────────────────────────────────────────
# Must match the backend's Cashfree environment. staging-api.zygonich.com issues
# SANDBOX sessions, so keep this on "sandbox" for local/staging work — a
# production SDK env with a sandbox session fails with "token is not present".
# Real store builds pass --dart-define=PAYMENT_ENV=production, which wins anyway.
CASHFREE_ENVIRONMENT=sandbox
# No app credentials belong here — the backend holds the Cashfree API keys.
