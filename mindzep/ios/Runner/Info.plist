<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MindZep</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mindzep</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Privacy usage descriptions ──────────────────────────────────────
	     Every framework linked into the binary that touches a protected
	     resource needs a purpose string, or App Store Connect rejects the
	     upload. Camera/microphone are used by Agora calls; the photo library
	     strings cover image_picker / file_picker. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>MindZep needs microphone access so you can talk to your psychologist during a session.</string>
	<key>NSCameraUsageDescription</key>
	<string>MindZep needs camera access for video therapy sessions.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MindZep needs photo library access so you can choose a profile picture and attach documents.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MindZep needs permission to save images to your photo library.</string>

	<!-- ── Background execution ────────────────────────────────────────────
	     `audio` keeps an in-progress therapy call alive when the user leaves
	     the app. Do NOT add `voip` unless PushKit is actually implemented —
	     Apple rejects apps that declare it without a PKPushRegistry. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- ── App Transport Security ──────────────────────────────────────────
	     The backend currently runs on a plain-HTTP host reached by raw IP
	     (http://150.241.245.88:8090). ATS cannot whitelist an IP literal
	     through NSExceptionDomains, so arbitrary loads must be allowed or
	     every request fails silently on iOS.

	     Before submitting to the App Store, put the backend behind an HTTPS
	     domain, set NSAllowsArbitraryLoads back to false, and point the build
	     at it:
	       --dart-define=API_BASE_URL=https://api.mindzep.com
	       --dart-define=SOCKET_BASE_URL=https://api.mindzep.com -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- ── Export compliance ───────────────────────────────────────────────
	     The app implements no encryption of its own and uses only the
	     platform's standard TLS, which is exempt. Declaring this here stops
	     App Store Connect asking on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
