# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local properties (contains machine-specific SDK paths)
android/local.properties

# Analysis output files (generated locally, not for version control).
# NOTE: analysis_options.yaml is a real project file and is deliberately NOT
# listed here — it drives `flutter analyze` and must be committed.
analysis*.txt
analysis*.md
analysis*.tsv
analyze_output.txt
output.txt
test_results.txt

# Internal documentation — specs, setup guides and plans stay local.
# (git's ignore matching is case-sensitive, hence both spellings.)
*_GUIDE.md
*_Guide.md
*_SPECIFICATION.md
*_Specification.md
*_PLAN.md
*_Plan.md
*_plan.txt
*.local.md
/docs/

# Store listing collateral (regenerated by tools/generate_play_console_assets.py)
play_console_assets/

# Environment / secrets
.env
.env.*
!.env.example

# Firebase / Google Services credentials — copy these in per machine, they are
# never committed. See the deployment runbook for where to download them.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# iOS signing material
ios/*.mobileprovision
ios/ExportOptions.plist
ios/Runner/*.entitlements.local

# VS Code settings (optional - uncomment if you don't want to share)
# .vscode/
